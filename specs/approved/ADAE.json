  "variable": "ASTDT",
  "label": "Analysis Start Date",
  "type": "date",
  "origin": "derived",
  "derivation": "Convert AE.AESTDTC to numeric date; partial-date imputation: if year and month match TRTSDT year/month then impute to TRTSDT (date of first dose), else if partial date clearly indicates start prior to treatment then no imputation (leave missing), else impute to first day of month/year per sponsor convention - REVIEW"
 },
 {
  "variable": "ASTDTF",
  "label": "Analysis Start Date Imputation Flag",
