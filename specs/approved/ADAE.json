 {
  "variable": "ASTDT",
  "label": "Analysis Start Date",
  "type": "date",
  "origin": "derived",
  "derivation": "Convert AE.AESTDTC to date; partial-date imputation: if year and month match TRTSDT year/month then impute day as TRTSDT day; if completely missing impute as TRTSDT; if partial date clearly indicates start prior to TRTSDT then leave missing; otherwise sponsor convention - REVIEW"
 },
 {
  "variable": "ASTDTF",
  "label": "Analysis Start Date Imputation Flag",
  "type": "text",
  "origin": "derived",
  "derivation": "Derived per CDISC ADaMIG based on imputation applied to ASTDT (D=day, M=month, Y=year, blank=none)"
 },
 {
  "variable": "ASTDY",
  "label": "Analysis Start Relative Day",
  "type": "integer",
  "origin": "derived",
  "derivation": "If ASTDT >= TRTSDT then ASTDT - TRTSDT + 1 else ASTDT - TRTSDT"
 },
 {
  "variable": "AENDT",
  "label": "Analysis End Date",
  "type": "date",
  "origin": "derived",
  "derivation": "Convert AE.AEENDTC to date; partial-date imputation: sponsor convention - REVIEW"
 },
 {
  "variable": "AENDY",
  "label": "Analysis End Relative Day",
  "type": "integer",
  "origin": "derived",
  "derivation": "If AENDT >= TRTSDT then AENDT - TRTSDT + 1 else AENDT - TRTSDT"
 },
 {
  "variable": "ADURN",
  "label": "Analysis Duration",
  "type": "float",
  "origin": "derived",
  "derivation": "AENDT - ASTDT + 1 (if both non-missing)"
 },
 {
  "variable": "ADURU",
  "label": "Analysis Duration Unit",
  "type": "text",
  "origin": "assigned",
  "derivation": "'DAYS'"
 },
 {
  "variable": "TRTEMFL",
  "label": "Treatment Emergent Analysis Flag",
  "type": "text",
  "origin": "derived",
  "derivation": "Y if (ASTDT >= TRTSDT) OR (ASTDT < TRTSDT and AENDT >= TRTSDT and AEOUT indicates worsening/recurrence per SAP) OR (ASTDT missing and imputed per SAP rules); else blank"
 },
 {
  "variable": "AOCCFL",
  "label": "First Occurrence Flag (Any AE)",
  "type": "text",
  "origin": "derived",
  "derivation": "Subset TRTEMFL='Y'; by USUBJID; sort by ASTDT, AESEQ; flag first record per USUBJID as 'Y', else blank"
 },
 {
  "variable": "AOCCPFL",
  "label": "First Occurrence Flag (Preferred Term)",
  "type": "text",
  "origin": "derived",
  "derivation": "Subset TRTEMFL='Y'; by USUBJID, AEDECOD; sort by ASTDT, AESEQ; flag first record per USUBJID/AEDECOD as 'Y', else blank"
 },
 {
  "variable": "AOCCSFL",
  "label": "First Occurrence Flag (System Organ Class)",
  "type": "text",
  "origin": "derived",
  "derivation": "Subset TRTEMFL='Y'; by USUBJID, AESOC; sort by ASTDT, AESEQ; flag first record per USUBJID/AESOC as 'Y', else blank"
 },
 {
  "variable": "ADERMFL",
  "label": "Dermatological Event Flag",
  "type": "text",
  "origin": "derived",
  "derivation": "Y if AEDECOD is in the predefined list of dermatological preferred terms per SAP medical review; else blank"
 }
