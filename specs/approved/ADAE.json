 {
  "variable": "TRTEMFL",
  "label": "Treatment Emergent Analysis Flag",
  "type": "text",
  "origin": "derived",
  "derivation": "Flag 'Y' if event meets treatment-emergent definition per SAP: (ASTDT >= TRTSDT) OR (ASTDT < TRTSDT and AENDT >= TRTSDT and worsening after TRTSDT per investigator) OR (ASTDT < TRTSDT and AENDT < TRTSDT and recurrence after TRTSDT); else blank. For partial dates: if year/month same as TRTSDT year/month then 'Y'; if completely missing ASTDT then impute ASTDT = TRTSDT and flag 'Y'; if partial date clearly prior to treatment then blank."
 },
 {
  "variable": "AOCCFL",
  "label": "First Occurrence Flag (Any AE)",
  "type": "text",
  "origin": "derived",
  "derivation": "Subset: TRTEMFL = 'Y'; by-group: USUBJID; sort: ASTDT, AESEQ; flag first record per by-group 'Y', else blank"
 },
 {
